rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && resource.data.createdByUid is string
        && request.auth.uid == resource.data.createdByUid;
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function hasSameExistingItems(newItems, oldItems) {
      return newItems is list
        && oldItems is list
        && newItems.size() == oldItems.size() + 1
        && newItems[0:oldItems.size()] == oldItems;
    }

    function validElectionCreate() {
      return signedIn()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdBy is string
        && request.resource.data.title is string
        && request.resource.data.createdAt is string
        && request.resource.data.candidates is list
        && request.resource.data.votes is list
        && request.resource.data.votes.size() == 0
        && request.resource.data.submissionsClosed is bool
        && request.resource.data.votingOpen is bool;
    }

    function ownerUpdate() {
      return isOwner()
        && request.resource.data.createdByUid == resource.data.createdByUid;
    }

    function isLegacyElection() {
      return !(resource.data.createdByUid is string);
    }

    function legacyUpdate() {
      return isLegacyElection()
        && !(request.resource.data.createdByUid is string);
    }

    function publicCandidateAppend() {
      return signedIn()
        && resource.data.submissionsClosed == false
        && changedOnly(['candidates'])
        && hasSameExistingItems(request.resource.data.candidates, resource.data.candidates);
    }

    match /elections/{electionId} {
      allow read: if true;
      allow create: if validElectionCreate();
      allow update: if ownerUpdate() || legacyUpdate() || publicCandidateAppend();
      allow delete: if isOwner() || isLegacyElection();

      // Ballots live in a subcollection keyed by the voter's uid, which limits
      // each signed-in user to one ballot per election: create requires the doc
      // id to be the caller's uid, and there is no update rule, so writing a
      // second ballot to the same id is rejected. Ballots cast before this
      // change remain in the election doc's `votes` array and still count.
      match /votes/{voterUid} {
        function election() {
          return get(/databases/$(database)/documents/elections/$(electionId)).data;
        }

        function validVote() {
          let vote = request.resource.data;
          return vote.keys().hasOnly(['voterName', 'ranking', 'approved', 'scores', 'timestamp'])
            && vote.voterName is string
            && vote.ranking is list
            && vote.approved is list
            && vote.timestamp is string
            && (!('scores' in vote) || vote.scores is map);
        }

        // Mirrors the election doc's delete rule (owner, or anyone for a legacy
        // election with no owner uid), so whoever can delete the election can
        // also clear its ballots first.
        function canManageElection() {
          let owner = election().get('createdByUid', null);
          return !(owner is string) || (signedIn() && request.auth.uid == owner);
        }

        allow read: if true;
        allow create: if signedIn()
          && request.auth.uid == voterUid
          && election().votingOpen == true
          && validVote();
        allow delete: if canManageElection();
      }
    }
  }
}
